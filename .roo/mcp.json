{
	"mcpServers": {
		"playwright": {
			"type": "stdio",
			"command": "cmd",
			"args": [
				"/c",
				"npx",
				"-y",
				"@playwright/mcp@latest"
			],
			"disabled": false,
			"alwaysAllow": [
				"browser_network_requests",
				"browser_network_request",
				"browser_snapshot",
				"browser_click",
				"browser_navigate",
				"browser_run_code_unsafe",
				"browser_wait_for",
				"browser_fill_form",
				"browser_console_messages",
				"browser_navigate_back",
				"browser_find",
				"browser_take_screenshot"
			]
		}
	}
}